# TrueFoundry Configuration (Required for real execution)
# Get your API key from https://truefoundry.com
TRUEFOUNDRY_API_KEY=your-api-key-here
TRUEFOUNDRY_ENDPOINT=https://api.truefoundry.com

# Engine Configuration
SESSION_POOL_SIZE=4
DEFAULT_TIMEOUT=180000
ENABLE_CACHING=true
CACHE_DIR=./.cache

# Viewer Configuration
VIEWER_PORT=3000
VIEWER_HOST=localhost

# Demo Configuration
DEMO_FLASK_PORT=5000