{
  "name": "speculative-engine",
  "displayName": "Speculative Engine",
  "description": "Run multiple AI strategies in parallel, compare outcomes, pick the best. TrueFoundry Forge-a-thon entry.",
  "version": "0.1.1",
  "author": "Edwin Aby",
  "publisher": "Edwin Aby",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:speculativeEngine.run",
    "onView:speculativeEngine.outcomeViewer"
  ],
  "contributes": {
    "commands": [
      {
        "command": "speculativeEngine.run",
        "title": "Run Speculative Engine",
        "category": "Speculative Engine"
      },
      {
        "command": "speculativeEngine.openViewer",
        "title": "Open Outcome Viewer",
        "category": "Speculative Engine"
      },
      {
        "command": "speculativeEngine.configure",
        "title": "Configure Speculative Engine",
        "category": "Speculative Engine"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "speculativeEngine.outcomeViewer",
          "name": "Speculative Engine Results",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "Speculative Engine",
      "properties": {
        "speculativeEngine.truefoundryApiKey": {
          "type": "string",
          "default": "",
          "description": "TrueFoundry API Key for AI execution"
        },
        "speculativeEngine.truefoundryEndpoint": {
          "type": "string",
          "default": "https://api.truefoundry.com",
          "description": "TrueFoundry API endpoint"
        },
        "speculativeEngine.defaultStrategies": {
          "type": "array",
          "default": ["minimal", "robust", "performance"],
          "description": "Default strategies to run"
        },
        "speculativeEngine.maxParallelStrategies": {
          "type": "number",
          "default": 3,
          "description": "Maximum parallel strategies"
        }
      }
    },
    "keybinds": [
      {
        "command": "speculativeEngine.run",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorTextFocus"
      },
      {
        "command": "speculativeEngine.openViewer",
        "key": "ctrl+alt+o",
        "mac": "cmd+alt+o",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "lint": "eslint src --ext ts",
    "test": "jest"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0",
    "eslint": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "@types/jest": "^29.0.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "ws": "^8.14.0"
  }
}