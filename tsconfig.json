{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleResolution": "node"
  },
  "include": [
    "src/engine.ts",
    "src/extension.ts",
    "src/outcomeViewer.ts",
    "src/strategies/base.ts",
    "src/strategies/index.ts",
    "src/strategies/minimal.ts",
    "src/strategies/robust.ts",
    "src/strategies/performance.ts",
    "src/types.ts",
    "src/truefoundry.ts"
  ],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}